# 각 팀원은 이 파일을 복사하여 .env를 만들고 본인의 실제 접속정보를 입력하세요.
# .env는 Git에 커밋하지 마세요.

# Oracle DB
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SERVICE=

# 매장 도면 저장 경로
SHOPMAP_DIR=
# AI MAP 저장 경로
AIMAP_DIR=

# Java(Spring Boot) 서버
# 본인의 Java 서버 실행 환경에 맞게 IP를 입력하세요.
JAVA_BASE_URL=http://본인IP:9102
